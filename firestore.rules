rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Base rules
    match /{document=**} {
      allow read, write: if false; // Default deny all
    }
    
    // User data
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Dealers data
    match /dealers/{dealerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == dealerId;
    }
      // Chat security
    match /chats/{chatId} {
      // Only allow access if the user is a participant in the chat
      allow read, write: if request.auth != null && 
                        resource != null && 
                        request.auth.uid in resource.data.participants;
      
      // For new chat creation
      allow create: if request.auth != null && 
                    request.auth.uid in request.resource.data.participants;
      
      // Allow updating only specific fields for participants
      allow update: if request.auth != null && 
                   resource != null && 
                   request.auth.uid in resource.data.participants && 
                   (
                     // Allow updating unread count for the user's own counter
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount', 'lastMessage', 'lastUpdated']) ||
                     // Or when sending a new message (which updates lastMessage)
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastUpdated', 'unreadCount']) && 
                      request.resource.data.lastMessage.senderId == request.auth.uid)
                   );
                    
      // For chat messages
      match /messages/{messageId} {
        // Allow read only if user is a participant in the parent chat
        allow read: if request.auth != null && 
                    get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        
        // Allow create only if the user is a participant and is setting themselves as sender
        allow create: if request.auth != null && 
                      request.resource.data.senderId == request.auth.uid &&
                      get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        
        // Allow update if the user is the recipient (e.g., to mark messages as read)
        allow update: if request.auth != null &&
                      get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readTimestamp']);
      }
    }
  }
}
